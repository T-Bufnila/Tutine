{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tutine",
  "version": "1.0.0",
  "identifier": "com.tutine.app",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tutine",
        "width": 1100,
        "height": 740,
        "minWidth": 760,
        "minHeight": 480,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Tudor Bufnila",
    "copyright": "Copyright (C) 2026 Tudor Bufnila",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
